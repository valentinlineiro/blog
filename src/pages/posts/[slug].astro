---
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const base = import.meta.env.BASE_URL;
---
<html lang="en">
<head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><meta name="theme-color" content="#0b0d10" /><meta name="description" content={post.data.description} /><meta property="og:type" content="article" /><meta property="og:title" content={`${post.data.title} · Valen`} /><meta property="og:description" content={post.data.description} /><meta property="og:url" content={`https://valentinlineiro.github.io/blog/posts/${post.id}/`} /><title>{post.data.title} · Valen</title></head>
<body><main><header><a href={base}>Valen</a><nav><a href={`${base}archivo/`}>Archive</a><a href={`${base}sobre/`}>About</a></nav></header>
<article><a class="back" href={`${base}archivo/`}>← Archive</a><time datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString('en-GB', { day: '2-digit', month: 'long', year: 'numeric' })}</time><h1>{post.data.title}</h1>{post.data.description && <p class="lead">{post.data.description}</p>}<div class="content"><Content /></div><div class="afterword">Notes on reducing friction, making better decisions, and building systems that can change.<br /><a href={`${base}sobre/`}>About</a> · <a href="https://github.com/valentinlineiro">GitHub</a> · <a href="https://www.linkedin.com/in/valentinlineiro/">LinkedIn</a> · <a href={`${base}rss.xml`}>RSS</a></div></article>
<footer><a href={`${base}archivo/`}>← More notes</a></footer></main></body></html>
<style>
:global(*){box-sizing:border-box}:global(html),:global(body){background:#0b0d10}:global(body){margin:0;color:#e8e3da;font-family:Inter,ui-sans-serif,system-ui,sans-serif;line-height:1.8}main{max-width:900px;min-height:100vh;margin:auto;padding:0 48px}header{height:92px;border-bottom:1px solid #1d2025;display:flex;align-items:center;justify-content:space-between}header>a{font:1.55rem Georgia,serif;text-decoration:none}nav{display:flex;gap:34px}nav a{color:#858a92;text-decoration:none}nav a:hover{color:#e8e3da}article{max-width:700px;margin:auto;padding:78px 0}.back{display:block;color:#777d85;text-decoration:none;margin-bottom:58px}.back:hover{color:#e8e3da}time{display:block;color:#d7a66a;font-size:.82rem;letter-spacing:.05em}h1{font:400 clamp(3rem,7vw,5rem)/1.05 Georgia,serif;letter-spacing:-.045em;margin:14px 0 28px}.lead{font-size:1.2rem;color:#969ba3;margin:0 0 50px}.content{font-size:1.1rem;color:#b7bbc1}.content :global(h2){font:400 2rem/1.2 Georgia,serif;color:#e8e3da;margin:52px 0 18px}.content :global(h3){color:#e8e3da}.content :global(p){margin:0 0 26px}.content :global(a){color:#d7a66a}.content :global(blockquote){margin:32px 0;padding-left:22px;border-left:2px solid #d7a66a;color:#969ba3}.content :global(code){font-family:ui-monospace,SFMono-Regular,Menlo,monospace;color:#d7a66a}.content :global(pre){overflow:auto;padding:20px;background:#111419;border:1px solid #24272d;border-radius:4px}.afterword{margin-top:64px;padding-top:28px;border-top:1px solid #24272d;color:#777d85;font-size:.92rem}.afterword a{color:#d7a66a;text-decoration:none}footer{border-top:1px solid #24272d;padding:34px 0 42px}footer a{color:#777d85;text-decoration:none}footer a:hover{color:#e8e3da}@media(max-width:640px){main{padding:0 24px}header{height:78px}nav{gap:20px}article{padding:58px 0}.back{margin-bottom:42px}h1{font-size:3.1rem}.content{font-size:1.05rem}}
</style>