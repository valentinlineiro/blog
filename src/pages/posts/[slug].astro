---
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const base = import.meta.env.BASE_URL;
---
<html lang="en">
<head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><meta name="theme-color" content="#0b0d10" /><meta name="description" content={post.data.description} /><meta property="og:type" content="article" /><meta property="og:title" content={`${post.data.title} · Valentín Liñeiro`} /><meta property="og:description" content={post.data.description} /><meta property="og:url" content={`https://valentinlineiro.github.io/blog/posts/${post.id}/`} /><title>{post.data.title} · Valentín Liñeiro</title></head>
<body><main><header><a class="brand" href={base}><img src={`${base}brand/takt.svg`} alt="" width="18" height="18"/>Valentín Liñeiro</a><nav><a href={`${base}archive/`}>Archive</a><a href={`${base}about/`}>About</a></nav></header>
<article><a class="back" href={`${base}archive/`}>← All notes</a><time datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }).toUpperCase()}</time><h1>{post.data.title}</h1>{post.data.description && <p class="lead">{post.data.description}</p>}<div class="content"><Content /></div><div class="afterword"><p><strong>Valentín Liñeiro</strong> — Software engineer exploring architecture, AI-assisted engineering and developer productivity.</p><p><a href={`${base}about/`}>About</a> · <a href="https://github.com/valentinlineiro">GitHub</a> · <a href="https://www.linkedin.com/in/valentinlineiro/">LinkedIn</a> · <a href={`${base}rss.xml`}>RSS</a></p></div></article>
<footer><a href={`${base}archive/`}>← All notes</a></footer></main></body></html>
<style>
:global(*){box-sizing:border-box}:global(html),:global(body){background:#0b0d10}:global(body){margin:0;color:#e8e3da;font-family:ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;line-height:1.6}:global(:focus-visible){outline:2px solid #d7a66a;outline-offset:4px}main{max-width:900px;min-height:100vh;margin:auto;padding:0 48px;display:flex;flex-direction:column}header{height:82px;border-bottom:1px solid #1d2025;display:flex;align-items:center;justify-content:space-between}.brand{display:inline-flex;align-items:center;gap:9px;color:#e8e3da;font-size:1.25rem;text-decoration:none;letter-spacing:-.02em}.brand img{display:block}nav{display:flex;gap:28px}nav a{position:relative;color:#9aa0a8;text-decoration:none;font-size:.95rem}nav a:hover{color:#e8e3da}article{max-width:700px;margin:auto;padding:58px 0 64px}.back{display:inline-block;color:#9aa0a8;text-decoration:none;margin-bottom:38px;font-size:.9rem}.back:hover{color:#e8e3da}time{display:block;color:#d7a66a;font-size:.76rem;letter-spacing:.08em}h1{margin:10px 0 22px;font:400 clamp(2.35rem,4.5vw,3.35rem)/1.12 Georgia,"Times New Roman",serif;letter-spacing:-.035em}.lead{font-size:1.1rem;color:#a8adb3;margin:0 0 38px}.content{font-size:1.06rem;color:#c2c6cc;line-height:1.75}.content :global(h2){font:400 1.85rem/1.2 Georgia,"Times New Roman",serif;color:#e8e3da;margin:46px 0 16px;letter-spacing:-.02em}.content :global(h3){color:#e8e3da;margin-top:36px}.content :global(p){margin:0 0 24px}.content :global(a){color:#d7a66a}.content :global(blockquote){margin:30px 0;padding-left:20px;border-left:2px solid #d7a66a;color:#a8adb3}.content :global(code){font-family:ui-monospace,SFMono-Regular,Menlo,monospace;color:#d7a66a}.content :global(pre){overflow:auto;padding:18px;background:#111419;border:1px solid #24272d;border-radius:4px}.afterword{margin-top:52px;padding-top:24px;border-top:1px solid #24272d;color:#9aa0a8;font-size:.9rem}.afterword p{margin:0 0 8px}.afterword strong{color:#e8e3da;font-weight:600}.afterword a{color:#d7a66a;text-decoration:none}footer{border-top:1px solid #24272d;padding:28px 0 36px;font-size:.85rem}footer a{color:#9aa0a8;text-decoration:none}footer a:hover{color:#e8e3da}@media(max-width:640px){main{padding:0 24px}header{height:74px}.brand{font-size:1.15rem}nav{gap:16px}article{padding:46px 0 48px}.back{margin-bottom:32px}h1{font-size:2.35rem}.content{font-size:1rem}.afterword{margin-top:44px}}
</style>
