---
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const base = import.meta.env.BASE_URL;
---
<html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><meta name="theme-color" content="#0b0d10" /><meta name="description" content="An archive of Valentín Liñeiro's notes on software, systems, ideas, and building things that last." /><title>Archive · Valentín Liñeiro</title></head>
<body><main><header><a class="brand" href={base}><img src={`${base}brand/takt.svg`} alt="" width="18" height="18"/>Valentín Liñeiro</a><nav><a class="active" href={`${base}archive/`}>Archive</a><a href={`${base}about/`}>About</a></nav></header>
<article><p class="eyebrow">Archive</p><h1>Notes worth keeping.</h1>{posts.map((post) => <a class="post" href={`${base}posts/${post.id}/`}><time>{post.data.date.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }).toUpperCase()}</time><h2>{post.data.title}</h2>{post.data.description && <p>{post.data.description}</p>}</a>)}</article>
<footer><a href={base}>← Home</a><div><a href={`${base}about/`}>About</a><span> · </span><a href={`${base}rss.xml`}>RSS</a></div></footer></main></body></html>
<style>
:global(*){box-sizing:border-box}:global(html),:global(body){background:#0b0d10}:global(body){margin:0;color:#e8e3da;font-family:ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;line-height:1.6}:global(:focus-visible){outline:2px solid #d7a66a;outline-offset:4px}main{max-width:900px;min-height:100vh;margin:auto;padding:0 48px;display:flex;flex-direction:column}header{height:82px;border-bottom:1px solid #1d2025;display:flex;align-items:center;justify-content:space-between}.brand{display:inline-flex;align-items:center;gap:9px;color:#e8e3da;font-size:1.25rem;text-decoration:none;letter-spacing:-.02em}.brand img{display:block}nav{display:flex;gap:28px}nav a{position:relative;color:#9aa0a8;text-decoration:none;font-size:.95rem}nav a.active,nav a:hover{color:#e8e3da}.active:after{content:"";position:absolute;left:0;right:0;bottom:-9px;height:2px;background:#d7a66a}article{max-width:700px;padding:76px 0 64px}.eyebrow{margin:0 0 14px;color:#d7a66a;font-size:.82rem;letter-spacing:.06em}h1{margin:0 0 42px;font:400 clamp(2.35rem,4vw,3.1rem)/1.12 Georgia,"Times New Roman",serif;letter-spacing:-.035em}.post{display:block;padding:28px 0 32px;border-top:1px solid #24272d;text-decoration:none}.post:last-child{border-bottom:1px solid #24272d}.post time{color:#d7a66a;font-size:.76rem;letter-spacing:.08em}.post h2{margin:8px 0 8px;color:#e8e3da;font:400 clamp(1.65rem,3vw,2.25rem)/1.12 Georgia,"Times New Roman",serif;letter-spacing:-.025em}.post p{max-width:600px;margin:0;color:#a8adb3;font-size:1rem}.post:hover h2{color:#d7a66a}footer{margin-top:auto;display:flex;justify-content:space-between;padding:28px 0 36px;color:#9aa0a8;font-size:.85rem}footer a{color:inherit;text-decoration:none}footer a:hover{color:#e8e3da}@media(max-width:640px){main{padding:0 24px}header{height:74px}.brand{font-size:1.15rem}nav{gap:16px}article{padding:58px 0 48px}h1{margin-bottom:34px}.post{padding:24px 0 28px}.post h2{font-size:1.75rem}footer{gap:20px}}
</style>
