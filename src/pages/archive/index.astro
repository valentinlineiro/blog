---
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const base = import.meta.env.BASE_URL;
---
<html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><meta name="theme-color" content="#0b0d10" /><meta name="description" content="An archive of Valentín Liñeiro's notes on software, systems, ideas, and building things that last." /><title>Archive · Valentín Liñeiro</title></head>
<body><main><header><a href={base} style="display:inline-flex;align-items:center;gap:10px;font:1.55rem Georgia,serif;text-decoration:none"><img src={`${base}brand/takt.svg`} alt="" width="20" height="20"/>Valentín Liñeiro</a><nav><a class="active" href={`${base}archive/`}>Archive</a><a href={`${base}about/`}>About</a></nav></header>
<article><p class="eyebrow">Archive</p><h1>Notes worth keeping.</h1>{posts.map((post) => <a class="post" href={`${base}posts/${post.id}/`}><time>{post.data.date.toLocaleDateString('en-GB', { day: '2-digit', month: 'long', year: 'numeric' })}</time><h2>{post.data.title}</h2>{post.data.description && <p>{post.data.description}</p>}</a>)}</article>
<footer><a href={base}>← Home</a><div><a href={`${base}about/`}>About</a><span> · </span><a href={`${base}rss.xml`}>RSS</a></div></footer></main></body></html>
<style>:global(*){box-sizing:border-box}:global(html),:global(body){background:#0b0d10}:global(body){margin:0;color:#e8e3da;font-family:ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;line-height:1.8}:global(:focus-visible){outline:2px solid #d7a66a;outline-offset:4px}main{max-width:900px;min-height:100vh;margin:auto;padding:0 48px}header{height:92px;border-bottom:1px solid #1d2025;display:flex;align-items:center;justify-content:space-between}header>a{font:1.55rem Georgia,serif;text-decoration:none}nav{display:flex;gap:34px}nav a{color:#9aa0a8;text-decoration:none}nav a.active,nav a:hover{color:#e8e3da}.active:after{content:"";display:block;height:2px;margin-top:8px;background:#d7a66a}article{max-width:700px;padding:100px 0}.eyebrow{color:#d7a66a;letter-spacing:.08em;font-size:.82rem}h1{font:400 clamp(3rem,7vw,5rem)/1.05 Georgia,serif;letter-spacing:-.045em;margin:18px 0 58px}.post{display:block;padding:32px 0 36px;border-top:1px solid #24272d;text-decoration:none}.post:last-child{border-bottom:1px solid #24272d}.post time{color:#d7a66a;font-size:.82rem}.post h2{font:400 clamp(2rem,4vw,2.7rem)/1.1 Georgia,serif;margin:10px 0;color:#e8e3da}.post p{color:#a8adb3;font-size:1.05rem;margin:0;max-width:600px}.post:hover h2{color:#d7a66a}footer{display:flex;justify-content:space-between;padding:34px 0;color:#7a7f87}footer a{color:inherit;text-decoration:none}@media(max-width:640px){main{padding:0 24px}header{height:78px}nav{gap:20px}article{padding:76px 0}h1{margin-bottom:42px}footer{gap:20px}}
</style>
