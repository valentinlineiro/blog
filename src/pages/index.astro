---
const posts = [
  { title: 'Hola, mundo', date: '2026-08-22', slug: 'hola-mundo', description: 'Un espacio personal para escribir, observar y construir.' }
];
---
<html lang="es">
  <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><title>Valen</title><meta name="description" content="Blog personal de Valen." /></head>
  <body>
    <main>
      <header><h1>Valen</h1><p>Ideas, sistemas, cocina y lo que voy aprendiendo.</p></header>
      <section>
        {posts.map((post) => <article><time datetime={post.date}>{post.date}</time><h2><a href={`/posts/${post.slug}`}>{post.title}</a></h2><p>{post.description}</p></article>)}
      </section>
    </main>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(body) { margin: 0; background: #fafafa; color: #181818; font-family: system-ui, sans-serif; line-height: 1.6; }
  main { max-width: 720px; margin: 0 auto; padding: 72px 24px; }
  h1 { font-size: 2.5rem; margin-bottom: .25rem; }
  header p { color: #666; margin-top: 0; }
  article { border-top: 1px solid #ddd; padding: 28px 0; }
  time { color: #777; font-size: .85rem; }
  h2 { margin: .25rem 0; }
  a { color: inherit; text-decoration: none; }
  a:hover { text-decoration: underline; }
</style>