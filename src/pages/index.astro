---
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const base = import.meta.env.BASE_URL;
const formatDate = (date) =>
  date.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }).toUpperCase().replace('.', '');
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#0b0d10" />
    <meta name="description" content="Notes on software, systems, ideas, and the craft of building things that last." />
    <title>Valentín Liñeiro — Software, systems, and ideas</title>
  </head>
  <body>
    <div class="page">
      <header class="nav">
        <a class="brand" href={base}><img src={`${base}brand/takt.svg`} alt="" width="20" height="20" />Valentín Liñeiro</a>
        <nav aria-label="Main navigation">
          <a href={`${base}archive/`}>Archive</a>
          <a href={`${base}about/`}>About</a>
        </nav>
      </header>

      <main>
        <section class="intro" aria-labelledby="intro-title">
          <p class="eyebrow">Software · systems · ideas</p>
          <h1 id="intro-title">Notes on reducing friction, making better decisions, and building systems that can change.</h1>
        </section>

        <section class="posts" aria-labelledby="posts-title">
          <h2 id="posts-title" class="sr-only">Recent notes</h2>
          {posts.map((post) => (
            <a class="post" href={`${base}posts/${post.id}/`}>
              <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
              <h2>{post.data.title}</h2>
              {post.data.description && <p>{post.data.description}</p>}
            </a>
          ))}
        </section>
      </main>

      <footer>
        <span>© {new Date().getFullYear()} Valentín Liñeiro</span>
        <div class="links">
          <a href={`${base}about/`}>About</a>
          <a href="https://github.com/valentinlineiro">GitHub</a>
          <a href="https://www.linkedin.com/in/valentinlineiro/">LinkedIn</a>
          <a href={`${base}rss.xml`}>RSS</a>
        </div>
      </footer>
    </div>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(html) { background: #0b0d10; }
  :global(body) { margin: 0; background: #0b0d10; color: #e8e3da; font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; line-height: 1.6; }
  :global(:focus-visible) { outline: 2px solid #d7a66a; outline-offset: 4px; }
  .page { max-width: 900px; min-height: 100vh; margin: 0 auto; padding: 0 48px; display: flex; flex-direction: column; }
  .nav { height: 92px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid #1d2025; }
  .brand { display: inline-flex; align-items: center; gap: 10px; font-family: Georgia, "Times New Roman", serif; font-size: 1.55rem; text-decoration: none; letter-spacing: -0.02em; }
  .brand img { display: block; }
  nav { display: flex; gap: 34px; }
  nav a { position: relative; color: #9aa0a8; text-decoration: none; font-size: .95rem; }
  nav a:hover, nav a.active { color: #e8e3da; }
  nav a.active::after { content: ""; position: absolute; left: 0; right: 0; bottom: -10px; height: 2px; background: #d7a66a; }
  main { flex: 1; }
  .intro { padding: 104px 0 76px; max-width: 720px; }
  .eyebrow { margin: 0 0 18px; color: #d7a66a; font-size: .88rem; letter-spacing: .04em; }
  h1 { margin: 0; font-family: Georgia, "Times New Roman", serif; font-size: clamp(2.2rem, 4.2vw, 3.4rem); line-height: 1.15; font-weight: 400; letter-spacing: -0.04em; }
  .posts { border-top: 1px solid #24272d; }
  .post { display: block; padding: 48px 0 54px; border-bottom: 1px solid #24272d; max-width: 720px; text-decoration: none; }
  .post:hover h2 { color: #d7a66a; }
  time { color: #d7a66a; font-size: .82rem; letter-spacing: .08em; }
  .post h2 { margin: 10px 0 12px; font-family: Georgia, "Times New Roman", serif; font-size: clamp(2rem, 4vw, 3rem); line-height: 1.1; font-weight: 400; letter-spacing: -0.035em; color: #e8e3da; }
  .post p { max-width: 600px; margin: 0; color: #a8adb3; font-size: 1.08rem; }
  footer { display: flex; justify-content: space-between; gap: 24px; padding: 34px 0 42px; color: #7a7f87; font-size: .85rem; }
  footer a { color: inherit; text-decoration: none; }
  footer a:hover { color: #e8e3da; }
  .links { display: flex; gap: 18px; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
  @media (max-width: 640px) {
    .page { padding: 0 24px; }
    .nav { height: 78px; }
    nav { gap: 20px; }
    .intro { padding: 76px 0 58px; }
    h1 { font-size: 2rem; }
    .post { padding: 38px 0 44px; }
    .post h2 { font-size: 2.25rem; }
    footer { flex-direction: column; }
    .links { flex-wrap: wrap; }
  }
</style>
