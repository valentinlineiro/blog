---
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const base = import.meta.env.BASE_URL;
const formatDate = (date) =>
  date.toLocaleDateString('es-ES', { day: '2-digit', month: 'short', year: 'numeric' }).toUpperCase().replace('.', '');
---
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#0b0d10" />
    <meta name="description" content="Notas sobre software, sistemas, ideas y vida cotidiana." />
    <title>Valen</title>
  </head>
  <body>
    <div class="page">
      <header class="nav">
        <a class="brand" href={base}>Valen</a>
        <nav aria-label="Navegación principal">
          <a class="active" href={`${base}archivo/`}>Archivo</a>
          <a href={`${base}sobre/`}>Sobre</a>
        </nav>
      </header>

      <main>
        <section class="intro" aria-labelledby="intro-title">
          <p class="eyebrow">Software · sistemas · ideas · vida</p>
          <h1 id="intro-title">Valen</h1>
          <p class="lead">Notas sobre lo que construyo, lo que aprendo y lo que me hace pensar.</p>
        </section>

        <section class="posts" aria-labelledby="posts-title">
          <h2 id="posts-title" class="sr-only">Notas recientes</h2>
          {posts.map((post) => (
            <article class="post">
              <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
              <h2><a href={`${base}posts/${post.slug}/`}>{post.data.title}</a></h2>
              {post.data.description && <p>{post.data.description}</p>}
              <a class="read" href={`${base}posts/${post.slug}/`}>Leer <span aria-hidden="true">→</span></a>
            </article>
          ))}
        </section>
      </main>

      <footer>
        <span>© {new Date().getFullYear()} Valen</span>
        <a href={`${base}rss.xml`}>RSS</a>
      </footer>
    </div>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(html) { background: #0b0d10; }
  :global(body) { margin: 0; background: #0b0d10; color: #e8e3da; font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; line-height: 1.6; }
  :global(a) { color: inherit; }
  .page { max-width: 1080px; min-height: 100vh; margin: 0 auto; padding: 0 48px; display: flex; flex-direction: column; }
  .nav { height: 92px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid #1d2025; }
  .brand { font-family: Georgia, "Times New Roman", serif; font-size: 1.55rem; text-decoration: none; letter-spacing: -0.02em; }
  nav { display: flex; gap: 34px; }
  nav a { position: relative; color: #858a92; text-decoration: none; font-size: .95rem; }
  nav a:hover, nav a.active { color: #e8e3da; }
  nav a.active::after { content: ""; position: absolute; left: 0; right: 0; bottom: -10px; height: 2px; background: #d7a66a; }
  main { flex: 1; }
  .intro { padding: 104px 0 76px; max-width: 720px; }
  .eyebrow { margin: 0 0 18px; color: #d7a66a; font-size: .88rem; letter-spacing: .04em; }
  h1 { margin: 0; font-family: Georgia, "Times New Roman", serif; font-size: clamp(4rem, 9vw, 7rem); line-height: .95; font-weight: 400; letter-spacing: -0.055em; }
  .lead { max-width: 600px; margin: 28px 0 0; color: #969ba3; font-size: clamp(1.15rem, 2vw, 1.35rem); line-height: 1.65; }
  .posts { border-top: 1px solid #24272d; }
  .post { padding: 48px 0 54px; border-bottom: 1px solid #24272d; max-width: 720px; }
  time { color: #d7a66a; font-size: .82rem; letter-spacing: .08em; }
  .post h2 { margin: 10px 0 12px; font-family: Georgia, "Times New Roman", serif; font-size: clamp(2rem, 4vw, 3rem); line-height: 1.1; font-weight: 400; letter-spacing: -0.035em; }
  .post h2 a { text-decoration: none; }
  .post h2 a:hover { color: #d7a66a; }
  .post p { max-width: 600px; margin: 0; color: #969ba3; font-size: 1.08rem; }
  .read { display: inline-block; margin-top: 26px; color: #d7a66a; text-decoration: none; font-family: Georgia, "Times New Roman", serif; font-size: 1.05rem; }
  .read span { display: inline-block; margin-left: 6px; transition: transform .2s ease; }
  .read:hover span { transform: translateX(4px); }
  footer { display: flex; justify-content: space-between; padding: 34px 0 42px; color: #676c74; font-size: .85rem; }
  footer a { color: inherit; text-decoration: none; }
  footer a:hover { color: #e8e3da; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
  @media (max-width: 640px) {
    .page { padding: 0 24px; }
    .nav { height: 78px; }
    nav { gap: 20px; }
    .intro { padding: 76px 0 58px; }
    h1 { font-size: 4.2rem; }
    .lead { font-size: 1.08rem; }
    .post { padding: 38px 0 44px; }
    .post h2 { font-size: 2.25rem; }
  }
</style>