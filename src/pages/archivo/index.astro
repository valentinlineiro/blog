---
import { getCollection } from 'astro:content';
const posts = (await getCollection('posts')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const base = import.meta.env.BASE_URL;
const formatDate = (date) => date.toLocaleDateString('es-ES', { day: '2-digit', month: 'short', year: 'numeric' }).toUpperCase().replace('.', '');
---
<html lang="es">
<head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><meta name="theme-color" content="#0b0d10" /><title>Archivo · Valen</title></head>
<body><main>
<header><a href={base}>Valen</a><nav><a class="active" href={`${base}archivo/`}>Archivo</a><a href={`${base}sobre/`}>Sobre</a></nav></header>
<section class="intro"><p class="eyebrow">Archivo</p><h1>Todas las notas.</h1></section>
<section class="list">{posts.map((post) => <article><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time><h2><a href={`${base}posts/${post.slug}/`}>{post.data.title}</a></h2>{post.data.description && <p>{post.data.description}</p>}</article>)}</section>
<footer><a href={base}>← Inicio</a><a href={`${base}rss.xml`}>RSS</a></footer>
</main></body>
</html>
<style>
:global(*){box-sizing:border-box}:global(html),:global(body){background:#0b0d10}:global(body){margin:0;color:#e8e3da;font-family:Inter,ui-sans-serif,system-ui,sans-serif;line-height:1.6}main{max-width:900px;min-height:100vh;margin:auto;padding:0 48px}header{height:92px;border-bottom:1px solid #1d2025;display:flex;align-items:center;justify-content:space-between}header>a{font:1.55rem Georgia,serif;text-decoration:none}nav{display:flex;gap:34px}nav a{color:#858a92;text-decoration:none}nav a.active,nav a:hover{color:#e8e3da}.intro{padding:100px 0 70px}.eyebrow,time{color:#d7a66a;letter-spacing:.08em;font-size:.82rem}.intro h1{font:400 clamp(3rem,7vw,5rem)/1.05 Georgia,serif;letter-spacing:-.045em;margin:12px 0}.list{border-top:1px solid #24272d}.list article{padding:38px 0;border-bottom:1px solid #24272d}.list h2{font:400 clamp(1.8rem,4vw,2.6rem)/1.1 Georgia,serif;margin:8px 0}.list h2 a{text-decoration:none}.list h2 a:hover{color:#d7a66a}.list p{color:#969ba3;margin:0;max-width:620px}footer{display:flex;justify-content:space-between;padding:34px 0 42px}footer a{color:#777d85;text-decoration:none}footer a:hover{color:#e8e3da}@media(max-width:640px){main{padding:0 24px}header{height:78px}nav{gap:20px}.intro{padding:76px 0 55px}}
</style>